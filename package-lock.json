{
  "name": "asharp",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "asharp",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@asharp/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@asharp/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@asharp/cli",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "asharp": "src/index.js"
      }
    },
    "packages/core": {
      "name": "@asharp/core",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
